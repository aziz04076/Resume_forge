# ==========================================
# RESUMEFORGE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Database (PostgreSQL - Neon, Supabase, AWS RDS, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeforge?schema=public"

# 2. AI Providers (Real API keys required for AI features)
# Primary: Anthropic Claude 3.5 Sonnet / Haiku
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Optional Fallback / Provider Switch: OpenAI GPT-4o
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# 3. NextAuth / Authentication (Auth.js v5)
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Logins
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# 4. Optional GitHub Token for higher rate limits on GitHub import
GITHUB_ACCESS_TOKEN=""

# 5. Email Reminders (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# 6. Cloud Storage (S3 / Cloudflare R2 for resume assets & exports - optional)
STORAGE_BUCKET_NAME=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# 7. Cron Security (For scheduled follow-up email triggers)
CRON_SECRET="custom_secure_cron_token_here"
